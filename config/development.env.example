# SPDX-License-Identifier: MIT OR Apache-2.0
# Development permits plaintext only on explicit loopback. Retention: disabled.
MPL_PROFILE=development
MPL_BIND_HOST=127.0.0.1
MPL_BIND_PORT=50051
MPL_INSECURE=true
MPL_MAX_RECEIVE_BYTES=4194304
MPL_MAX_SEND_BYTES=4194304
MPL_MAX_FRAME_BYTES=2097152
MPL_QUEUE_CAPACITY=8
MPL_RUNNER_COUNT=1
MPL_WORKER_TIMEOUT_MS=500
MPL_SHUTDOWN_TIMEOUT_MS=2000
MPL_WORKER_FAILURE_THRESHOLD=2
MPL_DEVICE=cpu
MPL_ALLOW_CPU_FALLBACK=true
