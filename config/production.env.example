# SPDX-License-Identifier: MIT OR Apache-2.0
# Production requires TLS and an external registered worker. Retention: disabled.
MPL_PROFILE=production
MPL_BIND_HOST=0.0.0.0
MPL_BIND_PORT=50051
MPL_INSECURE=false
MPL_TLS_CERTIFICATE_FILE=certs/server.crt
MPL_TLS_PRIVATE_KEY_FILE=certs/server.key
MPL_MAX_RECEIVE_BYTES=4194304
MPL_MAX_SEND_BYTES=4194304
MPL_MAX_FRAME_BYTES=2097152
MPL_QUEUE_CAPACITY=16
MPL_RUNNER_COUNT=2
MPL_WORKER_TIMEOUT_MS=500
MPL_SHUTDOWN_TIMEOUT_MS=2000
MPL_WORKER_FAILURE_THRESHOLD=2
MPL_DEVICE=cuda
MPL_ALLOW_CPU_FALLBACK=false
