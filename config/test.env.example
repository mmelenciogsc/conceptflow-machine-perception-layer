# SPDX-License-Identifier: MIT OR Apache-2.0
# Tests use an ephemeral loopback port and synthetic frames. Retention: disabled.
MPL_PROFILE=test
MPL_BIND_HOST=127.0.0.1
MPL_BIND_PORT=0
MPL_INSECURE=true
MPL_MAX_RECEIVE_BYTES=1048576
MPL_MAX_SEND_BYTES=1048576
MPL_MAX_FRAME_BYTES=65536
MPL_QUEUE_CAPACITY=2
MPL_RUNNER_COUNT=1
MPL_WORKER_TIMEOUT_MS=250
MPL_SHUTDOWN_TIMEOUT_MS=2000
MPL_WORKER_FAILURE_THRESHOLD=2
MPL_DEVICE=cpu
MPL_ALLOW_CPU_FALLBACK=true
