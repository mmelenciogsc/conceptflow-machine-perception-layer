{
  "schema": "org.conceptflow.mpl.rokid.sensor-contract",
  "schema_version": 1,
  "captured_at": "2026-08-25",
  "repository_base_commit": "c115e5f",
  "status": "protected_working-tree_baseline",
  "production_handoff_at_inventory_time": "bounded_private_spool_pull",
  "camera": {
    "source_api": "android.camera2.CameraDevice",
    "capture_format": "JPEG",
    "preferred_capture": { "width": 1920, "height": 1080 },
    "image_reader_max_images": 2,
    "acquisition": "acquireLatestImage",
    "three_a_warmup": {
      "format": "YUV_420_888",
      "preferred_width": 640,
      "preferred_height": 480,
      "duration_ms": 1000
    },
    "source_limits": {
      "maximum_jpeg_bytes": 20971520,
      "maximum_outstanding_requests": 3
    },
    "gate": {
      "analysis_width": 160,
      "analysis_height": 90,
      "minimum_mean_luma": 18.0,
      "maximum_dark_fraction": 0.92,
      "minimum_laplacian_variance": 60.0,
      "material_motion_threshold": 0.06,
      "motion_hold_ns": 1500000000,
      "relaxed_fps": 3.0,
      "motion_fps": 5.0,
      "motion_algorithm": "exposure-compensated residual plus changed-pixel fraction plus 8x6 peak cell"
    },
    "post_gate_transform": {
      "rule": "scale landscape input to 640 pixels high with aspect ratio preserved, then centered crop to 640x640",
      "output_width": 640,
      "output_height": 640,
      "persisted_encoding": "JPEG",
      "persisted_jpeg_quality": 88,
      "maximum_output_bytes": 2097152,
      "intrinsics": "scale focal lengths and principal point, subtract centered crop offset"
    },
    "source_timestamp": "Camera2 Image.timestamp/SENSOR_TIMESTAMP normalized to strictly increasing nanoseconds",
    "timestamp_source_characteristic": "requires physical audit; not inferred"
  },
  "microphone": {
    "source_api": "android.media.AudioRecord",
    "audio_source": "MIC",
    "encoding": "PCM_S16LE",
    "sample_rate_hz": 16000,
    "channels": 1,
    "minimum_buffer_bytes": 4096,
    "maximum_buffer_bytes": 65536,
    "read_mode": "blocking",
    "gate": {
      "permission_required": "android.permission.RECORD_AUDIO",
      "node_must_be_active": true,
      "wearer_start_gesture": "forward swipe plus quick single tap",
      "wearer_stop_gesture": "backward swipe plus quick single tap",
      "authenticated_host_sublease_required": true,
      "maximum_sublease_ms": 10000,
      "local_stop_precedes_network_ack": true
    },
    "timestamp": "SystemClock.elapsedRealtimeNanos sampled after each blocking read and normalized strictly increasing",
    "legacy_persistence": "one PCM16 WAV file per admitted chunk"
  },
  "imu": {
    "source_api": "android.hardware.SensorManager",
    "orientation_sensor_preference": ["TYPE_GAME_ROTATION_VECTOR", "TYPE_ROTATION_VECTOR"],
    "component_sensors": ["TYPE_GYROSCOPE", "TYPE_LINEAR_ACCELERATION"],
    "sampling_period_us": 10000,
    "maximum_report_latency_us": 0,
    "coordinate_frame": "HEAD",
    "translation": "zero/unavailable",
    "gate": {
      "orientation_delta_radians": 0.008726646259971648,
      "angular_velocity_delta_radians_per_second": 0.02,
      "linear_acceleration_delta_meters_per_second_squared": 0.05,
      "maximum_silence_ns": 1000000000,
      "maximum_batch_delay_ns": 20000000,
      "maximum_samples_per_batch": 8,
      "rejects": ["invalid", "non-finite", "non-increasing sequence", "non-increasing timestamp"]
    },
    "timestamp": "SensorEvent.timestamp nanoseconds; component timestamps must exist and not exceed the orientation timestamp"
  },
  "touch": {
    "source_api": "AccessibilityService.onKeyEvent",
    "consumes_platform_events": false,
    "hardware_identity": {
      "device_name": "ROKID,PSOC-TP-R",
      "source": 257,
      "virtual": false
    },
    "key_map": [
      { "android_key_code": 83, "scan_code": 204, "meaning": "PREAMBLE" },
      { "android_key_code": 24, "scan_code": 115, "meaning": "SWIPE_FORWARD" },
      { "android_key_code": 25, "scan_code": 114, "meaning": "SWIPE_BACKWARD" },
      { "android_key_code": 186, "scan_code": 148, "meaning": "SINGLE_TAP" },
      { "android_key_code": 185, "scan_code": 400, "meaning": "DOUBLE_TAP" }
    ],
    "gesture_state": {
      "preamble_timeout_ms": 900,
      "followup_timeout_ms": 1600,
      "repeated_swipe_collapse_ms": 350,
      "quick_tap_maximum_ms": 500,
      "key_hold_maximum_ms": 1200,
      "enable": "forward swipe plus app-visible double-tap completion preambles",
      "disable": "backward swipe plus app-visible double-tap completion preambles",
      "microphone_start": "active node plus forward swipe plus quick single tap",
      "microphone_stop": "active node plus backward swipe plus quick single tap",
      "resets_on": ["untrusted device", "canceled event", "long press", "unrelated key", "invalid action", "non-monotonic event time", "device change"]
    },
    "timestamp": "KeyEvent.eventTime uptime milliseconds",
    "known_clock_boundary": "must be converted at capture to the authoritative glasses elapsed-realtime timeline without changing gesture timing semantics"
  },
  "current_transport": {
    "security": "mutual TLS 1.3 with exact peer public-key pinning",
    "data_plane": "private WLAN TCP",
    "lanes": ["realtime_control", "camera"],
    "framing": "four-byte big-endian bounded protobuf length prefix",
    "clock_sync": "repeated NTP-style four-timestamp minimum-RTT estimate",
    "camera_queue": "one complete latest frame",
    "imu_queue": "bounded batches; live outbox currently retains the latest batch",
    "microphone_queue": "one latest chunk",
    "touch_transport": "typed high-level gesture intents only; raw ordered touch events are not yet transported",
    "legacy_spool": {
      "maximum_records": 512,
      "maximum_artifact_bytes": 67108864,
      "manifest_flush_minimum_interval_ns": 100000000,
      "poll_nominal_hz": 10,
      "page_records": 16,
      "artifact_chunk_bytes": 49152
    }
  },
  "regression_tests": [
    "AdaptiveCaptureTest",
    "SquareAspectFillTransformTest",
    "Camera2FrameSourceTest",
    "AudioRecordInputSourceTest",
    "ImuSignalReadinessTest",
    "ImuTransmissionGateTest",
    "RokidInputSequenceTest",
    "LiveLinkCaptureControllerTest",
    "SensorStreamOutboxTest",
    "SensorStreamPacketizerTest",
    "BoundedProtobufFramingTest",
    "ClockSynchronizationTest",
    "GlassesStreamIngressTest"
  ]
}
