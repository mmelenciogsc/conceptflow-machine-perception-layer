#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
set -euo pipefail

readonly PACKAGE="org.conceptflow.mpl.androidhost"
readonly VOCABULARY_SHA256="f4d5aee2124ee9a65f337337004062b15273939ff0ce7f96740fc3cb28d6a9a6"
readonly YOLOE_SHA256="4631e169dd0a335e48f9f3bb039be414810450ae232a1d1d1212bd457f954fd7"
readonly DEPTH_INDOOR_392_SHA256="e79b4c0e3b38b815be47287b232137b4217097a7553da90869dfd482cd2a449d"
readonly DEPTH_OUTDOOR_392_SHA256="f77804ac22fd6f7586e640b231df9e2e759e7325308f2430fae6f67be0be60c4"

usage() {
    printf '%s\n' \
        "Usage: $0 --serial SERIAL --yoloe FILE --depth-indoor-392 FILE --depth-outdoor-392 FILE [OPTIONS]" \
        "Options: --depth-indoor-336 FILE --depth-outdoor-336 FILE" \
        "         --depth-indoor-518 FILE --depth-outdoor-518 FILE" \
        "         --allow-untrusted-development" \
        "Legacy aliases --depth-indoor/--depth-outdoor provision the optional 518 reference slots." \
        "Privately provisions already converted, licensed QNN artifacts into a debuggable Android Node install." \
        "The script never downloads models and never copies them into this repository."
}

serial=""
yoloe=""
depth_indoor_336=""
depth_outdoor_336=""
depth_indoor_392=""
depth_outdoor_392=""
depth_indoor_518=""
depth_outdoor_518=""
allow_untrusted_development=false
while (($#)); do
    case "$1" in
        --serial) serial="${2:-}"; shift 2 ;;
        --yoloe) yoloe="${2:-}"; shift 2 ;;
        --depth-indoor-336) depth_indoor_336="${2:-}"; shift 2 ;;
        --depth-outdoor-336) depth_outdoor_336="${2:-}"; shift 2 ;;
        --depth-indoor-392) depth_indoor_392="${2:-}"; shift 2 ;;
        --depth-outdoor-392) depth_outdoor_392="${2:-}"; shift 2 ;;
        --depth-indoor-518|--depth-indoor) depth_indoor_518="${2:-}"; shift 2 ;;
        --depth-outdoor-518|--depth-outdoor) depth_outdoor_518="${2:-}"; shift 2 ;;
        --allow-untrusted-development) allow_untrusted_development=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ -z "$serial" || -z "$yoloe" || -z "$depth_indoor_392" || -z "$depth_outdoor_392" ]]; then
    usage >&2
    exit 2
fi
if { [[ -n "$depth_indoor_336" && -z "$depth_outdoor_336" ]] ||
    [[ -z "$depth_indoor_336" && -n "$depth_outdoor_336" ]]; }; then
    printf 'The optional 336 indoor/outdoor artifacts must be provisioned together.\n' >&2
    exit 2
fi
if { [[ -n "$depth_indoor_518" && -z "$depth_outdoor_518" ]] ||
    [[ -z "$depth_indoor_518" && -n "$depth_outdoor_518" ]]; }; then
    printf 'The optional 518 indoor/outdoor artifacts must be provisioned together.\n' >&2
    exit 2
fi
command -v adb >/dev/null || { printf 'adb is required.\n' >&2; exit 1; }
command -v sha256sum >/dev/null || { printf 'sha256sum is required.\n' >&2; exit 1; }
command -v readelf >/dev/null || { printf 'readelf is required.\n' >&2; exit 1; }

device_state="$(adb -s "$serial" get-state 2>/dev/null || true)"
[[ "$device_state" == "device" ]] || { printf 'Selected Android device is not authorized and online.\n' >&2; exit 1; }
adb -s "$serial" shell pm path "$PACKAGE" >/dev/null 2>&1 || {
    printf 'Install the debuggable Android Node APK before provisioning models.\n' >&2
    exit 1
}
adb -s "$serial" shell run-as "$PACKAGE" mkdir -p files/models || {
    printf 'run-as failed; this provisioning helper requires a debuggable app build.\n' >&2
    exit 1
}
adb -s "$serial" shell run-as "$PACKAGE" chmod 700 files/models

provision() {
    local source_path="$1"
    local target_name="$2"
    local maximum_bytes="$3"
    local trusted_checksum="${4:-}"
    [[ -f "$source_path" ]] || { printf 'Missing artifact: %s\n' "$source_path" >&2; exit 1; }
    local elf_header
    elf_header="$(readelf -h -- "$source_path" 2>/dev/null || true)"
    if ! grep -q 'Class:.*ELF64' <<<"$elf_header" ||
        ! grep -q 'Data:.*little endian' <<<"$elf_header" ||
        ! grep -q 'Machine:.*AArch64' <<<"$elf_header"; then
        printf 'Artifact is not an ELF64 little-endian AArch64 QNN model library: %s\n' "$source_path" >&2
        exit 1
    fi
    local size_bytes
    size_bytes="$(stat -c '%s' -- "$source_path")"
    if ((size_bytes < 1 || size_bytes > maximum_bytes)); then
        printf 'Artifact size is outside the allowed bound for %s.\n' "$target_name" >&2
        exit 1
    fi
    local checksum
    checksum="$(sha256sum -- "$source_path")"
    checksum="${checksum%% *}"
    if [[ "$allow_untrusted_development" != true && "$checksum" != "$trusted_checksum" ]]; then
        printf 'Artifact digest is not a trusted production pin for %s: %s\n' "$target_name" "$checksum" >&2
        exit 1
    fi
    printf 'Provisioning %s (%s bytes).\n' "$target_name" "$size_bytes"
    adb -s "$serial" shell run-as "$PACKAGE" rm -f "files/models/$target_name.tmp"
    if ! adb -s "$serial" exec-in run-as "$PACKAGE" sh -c \
        "umask 077; cat > files/models/$target_name.tmp" < "$source_path"; then
        adb -s "$serial" shell run-as "$PACKAGE" rm -f "files/models/$target_name.tmp" || true
        printf 'Transfer interrupted for %s; the previous installed artifact was preserved.\n' "$target_name" >&2
        exit 1
    fi
    local installed_checksum
    installed_checksum="$(adb -s "$serial" shell run-as "$PACKAGE" sha256sum "files/models/$target_name.tmp")"
    installed_checksum="${installed_checksum%% *}"
    [[ "$installed_checksum" == "$checksum" ]] || {
        adb -s "$serial" shell run-as "$PACKAGE" rm -f "files/models/$target_name.tmp" || true
        printf 'Post-transfer checksum mismatch for %s.\n' "$target_name" >&2
        exit 1
    }
    adb -s "$serial" shell run-as "$PACKAGE" mv \
        "files/models/$target_name.tmp" "files/models/$target_name"
    adb -s "$serial" shell run-as "$PACKAGE" chmod 600 "files/models/$target_name"
    write_sidecar "$target_name.sha256" "$checksum"
}

write_sidecar() {
    local target_name="$1"
    local value="$2"
    if ! printf '%s\n' "$value" | adb -s "$serial" exec-in run-as "$PACKAGE" sh -c \
        "cat > files/models/$target_name.tmp"; then
        adb -s "$serial" shell run-as "$PACKAGE" rm -f "files/models/$target_name.tmp" || true
        printf 'Sidecar transfer interrupted for %s.\n' "$target_name" >&2
        exit 1
    fi
    if ! adb -s "$serial" shell run-as "$PACKAGE" mv \
        "files/models/$target_name.tmp" "files/models/$target_name"; then
        adb -s "$serial" shell run-as "$PACKAGE" rm -f "files/models/$target_name.tmp" || true
        printf 'Sidecar commit failed for %s.\n' "$target_name" >&2
        exit 1
    fi
    adb -s "$serial" shell run-as "$PACKAGE" chmod 600 "files/models/$target_name"
}

provision "$yoloe" "libyoloe_bvi330_fp16.so" $((256 * 1024 * 1024)) "$YOLOE_SHA256"
write_sidecar "libyoloe_bvi330_fp16.so.vocabulary.sha256" "$VOCABULARY_SHA256"
provision "$depth_indoor_392" "libdepth_indoor_392_fp16.so" $((512 * 1024 * 1024)) "$DEPTH_INDOOR_392_SHA256"
provision "$depth_outdoor_392" "libdepth_outdoor_392_fp16.so" $((512 * 1024 * 1024)) "$DEPTH_OUTDOOR_392_SHA256"

optional_count=0
if [[ -n "$depth_indoor_336" ]]; then
    provision "$depth_indoor_336" "libdepth_indoor_336_fp16.so" $((512 * 1024 * 1024))
    provision "$depth_outdoor_336" "libdepth_outdoor_336_fp16.so" $((512 * 1024 * 1024))
    optional_count=$((optional_count + 2))
fi
if [[ -n "$depth_indoor_518" ]]; then
    provision "$depth_indoor_518" "libdepth_indoor_fp16.so" $((512 * 1024 * 1024))
    provision "$depth_outdoor_518" "libdepth_outdoor_fp16.so" $((512 * 1024 * 1024))
    optional_count=$((optional_count + 2))
fi

printf 'All three required runtime artifacts passed byte-for-byte transfer verification.\n'
printf '%s optional depth artifacts were also provisioned.\n' "$optional_count"
printf 'Restart the Android Node to refresh its model readiness status.\n'
