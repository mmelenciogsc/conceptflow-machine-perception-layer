#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0

set -euo pipefail
# shellcheck source=lib/common.sh
source "$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"
# shellcheck source=lib/rokid-adb.sh
source "$SCRIPT_DIRECTORY/lib/rokid-adb.sh"
cd "$REPOSITORY_ROOT"

readonly PACKAGE_NAME="org.conceptflow.mpl.rokidclient"
readonly DEFAULT_APK="apps/rokid-client/build/outputs/apk/debug/rokid-client-debug.apk"

serial=""
apk_path="$DEFAULT_APK"
build_apk=true
grant_camera=false
grant_microphone=false
inspect_only=false

usage() {
    cat <<'EOF'
Usage: ./scripts/rokid-install [options]

Build and directly sideload the glasses APK over the Rokid 5-pin ADB cable.
No phone companion app, Rokid client secret, or proprietary SDK is used.

Options:
  --serial SERIAL   Explicit ADB serial. Required when multiple devices are attached.
  --apk PATH        Install PATH instead of the default debug APK; implies --no-build.
  --no-build        Use the existing default debug APK.
  --grant-camera    Grant only android.permission.CAMERA after installation.
  --grant-microphone Grant only android.permission.RECORD_AUDIO after installation.
  --inspect-only    Identify and validate the target without changing it.
  -h, --help        Show this help.
EOF
}

while (($# > 0)); do
    case "$1" in
        --serial)
            (($# >= 2)) || fail "--serial requires a value"
            serial="$2"
            shift 2
            ;;
        --apk)
            (($# >= 2)) || fail "--apk requires a path"
            apk_path="$2"
            build_apk=false
            shift 2
            ;;
        --no-build)
            build_apk=false
            shift
            ;;
        --grant-camera)
            grant_camera=true
            shift
            ;;
        --grant-microphone)
            grant_microphone=true
            shift
            ;;
        --inspect-only)
            inspect_only=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            fail "unknown option '$1'; use --help"
            ;;
    esac
done

select_rokid_target "$serial"
verify_rokid_target

if [[ "$inspect_only" == true ]]; then
    printf 'Inspection complete; no build, install, permission, or launch command was run.\n'
    exit 0
fi

if [[ "$build_apk" == true ]]; then
    run_gradle :apps:rokid-client:assembleDebug
fi

[[ -f "$apk_path" ]] || fail "APK not found: $apk_path"

adb -s "$ROKID_SERIAL" install -r "$apk_path"

if [[ "$grant_camera" == true ]]; then
    adb -s "$ROKID_SERIAL" shell pm grant "$PACKAGE_NAME" android.permission.CAMERA
    printf 'Granted android.permission.CAMERA at the operator request.\n'
fi

if [[ "$grant_microphone" == true ]]; then
    adb -s "$ROKID_SERIAL" shell pm grant "$PACKAGE_NAME" android.permission.RECORD_AUDIO
    printf 'Granted android.permission.RECORD_AUDIO at the operator request.\n'
fi

printf 'Direct sideload completed for %s on the selected Rokid target.\n' "$PACKAGE_NAME"
printf 'The nonvisual runtime remains stopped. Use ./scripts/rokid-control to start an explicit action.\n'
