#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
set -euo pipefail

usage() {
    printf '%s\n' \
        "Usage: $0 --qnn-sdk DIR --ndk DIR --onnx-dir DIR --calibration-dir DIR --output-dir DIR [--precision fp16|w8a16] [--models all|yoloe] --acknowledge-ultralytics-terms" \
        "Converts externally supplied ONNX graphs into private AArch64 QNN model libraries." \
        "Output must be outside this repository. No QNN binary or model artifact is copied into Git."
}

qnn_sdk=""
ndk=""
onnx_dir=""
calibration_dir=""
output_dir=""
precision="fp16"
models="all"
acknowledged=false
while (($#)); do
    case "$1" in
        --qnn-sdk) qnn_sdk="${2:-}"; shift 2 ;;
        --ndk) ndk="${2:-}"; shift 2 ;;
        --onnx-dir) onnx_dir="${2:-}"; shift 2 ;;
        --calibration-dir) calibration_dir="${2:-}"; shift 2 ;;
        --output-dir) output_dir="${2:-}"; shift 2 ;;
        --precision) precision="${2:-}"; shift 2 ;;
        --models) models="${2:-}"; shift 2 ;;
        --acknowledge-ultralytics-terms) acknowledged=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ -z "$qnn_sdk" || -z "$ndk" || -z "$onnx_dir" || -z "$calibration_dir" || -z "$output_dir" ]]; then
    usage >&2
    exit 2
fi
[[ "$precision" == "fp16" || "$precision" == "w8a16" ]] || {
    printf 'Precision must be fp16 or w8a16.\n' >&2
    exit 2
}
[[ "$models" == "all" || "$models" == "yoloe" ]] || {
    printf 'Models must be all or yoloe.\n' >&2
    exit 2
}
[[ "$acknowledged" == true ]] || {
    printf 'YOLOE conversion requires an explicit acknowledgement of its separately governed terms.\n' >&2
    exit 2
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
qnn_sdk="$(realpath -e -- "$qnn_sdk")"
ndk="$(realpath -e -- "$ndk")"
onnx_dir="$(realpath -e -- "$onnx_dir")"
calibration_dir="$(realpath -e -- "$calibration_dir")"
output_dir="$(realpath -m -- "$output_dir")"
case "$output_dir/" in
    "$repo_root/"*) printf 'QNN output must be outside the repository.\n' >&2; exit 2 ;;
esac
mkdir -p -- "$output_dir"
"$repo_root/scripts/android-model-prepare" verify-export --directory "$onnx_dir" >/dev/null

readonly converter="$qnn_sdk/bin/x86_64-linux-clang/qnn-onnx-converter"
readonly generator="$qnn_sdk/bin/x86_64-linux-clang/qnn-model-lib-generator"
[[ -x "$converter" && -x "$generator" ]] || {
    printf 'The selected QNN SDK does not contain the required host tools.\n' >&2
    exit 1
}
[[ -x "$ndk/ndk-build" ]] || { printf 'The selected Android NDK is incomplete.\n' >&2; exit 1; }

export QNN_SDK_ROOT="$qnn_sdk"
export ANDROID_NDK_ROOT="$ndk"
export PATH="$qnn_sdk/venv/bin:$ndk:$PATH"
export PYTHONPATH="$qnn_sdk/lib/python${PYTHONPATH:+:$PYTHONPATH}"
export LD_LIBRARY_PATH="$qnn_sdk/lib/x86_64-linux-clang${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

if [[ "$models" == "yoloe" ]]; then
    declare -a keys=(yoloe)
else
    declare -a keys=(yoloe depth-indoor depth-outdoor)
fi
declare -A onnx=(
    [yoloe]="$onnx_dir/yoloe-26s-bvi330-seg.onnx"
    [depth-indoor]="$onnx_dir/depth-anything-v2-metric-indoor-hypersim-vits.onnx"
    [depth-outdoor]="$onnx_dir/depth-anything-v2-metric-outdoor-vkitti-vits.onnx"
)
declare -A input_list=(
    [yoloe]="$calibration_dir/yoloe/yoloe-image-input-list.txt"
    [depth-indoor]="$calibration_dir/depth/depth-image-input-list.txt"
    [depth-outdoor]="$calibration_dir/depth/depth-image-input-list.txt"
)
declare -A stem=(
    [yoloe]="yoloe-26s-bvi330-seg"
    [depth-indoor]="depth-anything-v2-metric-indoor-hypersim-vits"
    [depth-outdoor]="depth-anything-v2-metric-outdoor-vkitti-vits"
)
declare -A library=(
    [yoloe]="yoloe_bvi330_${precision}"
    [depth-indoor]="depth_indoor_${precision}"
    [depth-outdoor]="depth_outdoor_${precision}"
)

for key in "${keys[@]}"; do
    [[ -f "${onnx[$key]}" ]] || { printf 'Missing ONNX graph: %s\n' "${onnx[$key]}" >&2; exit 1; }
    if [[ "$precision" == "w8a16" && ! -f "${input_list[$key]}" ]]; then
        printf 'Missing real-image calibration list: %s\n' "${input_list[$key]}" >&2
        exit 1
    fi
done

for key in "${keys[@]}"; do
    model_dir="$output_dir/$key-$precision"
    mkdir -p -- "$model_dir"
    cpp="$model_dir/${stem[$key]}.cpp"
    args=(--input_network "${onnx[$key]}" --output_path "$cpp")
    if [[ "$precision" == "fp16" ]]; then
        args+=(--float_bitwidth 16 --float_bias_bitwidth 16)
    else
        args+=(--input_list "${input_list[$key]}" --weights_bitwidth 8 --act_bitwidth 16 --bias_bitwidth 32)
        if [[ "$key" == "yoloe" ]]; then
            args+=(--preserve_io datatype images output0 output1)
        else
            args+=(--preserve_io datatype images depth_meters)
        fi
    fi
    printf 'Converting %s (%s).\n' "$key" "$precision"
    (cd "$model_dir" && "$converter" "${args[@]}")
    "$generator" \
        --cpp "$cpp" \
        --bin "$model_dir/${stem[$key]}.bin" \
        --lib_targets aarch64-android \
        --lib_name "${library[$key]}" \
        --output_dir "$model_dir/lib"
done

printf 'Private QNN model libraries:\n'
for key in "${keys[@]}"; do
    artifact="$output_dir/$key-$precision/lib/aarch64-android/lib${library[$key]}.so"
    [[ -f "$artifact" ]] || { printf 'Expected output missing: %s\n' "$artifact" >&2; exit 1; }
    sha256sum -- "$artifact"
done
