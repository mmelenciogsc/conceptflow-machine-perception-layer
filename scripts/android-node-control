#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0

set -euo pipefail

readonly PACKAGE_NAME="org.conceptflow.mpl.androidhost"
readonly CONTROL_URI="content://org.conceptflow.mpl.androidhost.debug-control"
readonly CONTROL_ACTIVITY="$PACKAGE_NAME/org.conceptflow.mpl.androidhost.AndroidNodeDebugControlActivity"

usage() {
    cat <<'EOF'
Usage: ./scripts/android-node-control --serial SERIAL COMMAND

Shell-only controls exposed by the debuggable Android Node APK. These controls
are absent from release builds and do not change TalkBack or device settings.

Commands:
  start-automatic  Start the persistent listener with automatic depth routing.
  start-indoor     Start it with the indoor depth profile forced.
  start-outdoor    Start it with the outdoor depth profile forced.
  microphone       Request one bounded on-demand glasses microphone lease.
  ambient-profile  Request one bounded, content-free ambient sound profile.
  speech-timeout-probe Run a debug-only, content-free native Whisper deadline probe.
  speech-timeout-probe-status Return the native Whisper deadline-probe result.
  avc-decode-fault Arm one debug-only AVC decode failure to validate automatic I420 fallback.
  wifi-direct-recover Explicitly replace an empty phone-owned Wi-Fi Direct group.
  wifi-direct-recover-5ghz Replace an empty group on the previously validated 5-GHz band.
  wifi-direct-negotiate Remove an empty autonomous group and await ordinary peer negotiation.
  wifi-direct-recovery-status Return the last sanitized group-recovery result.
  status           Return the current aggregate, content-free runtime status.
  focus-status     Return the current linear-focus state.
  focus-next       Move to the next spatial item.
  focus-previous   Move to the previous spatial item.
  focus-activate   Open or confirm the focused-item action.
  focus-back       Return from the current focus action or leave browsing.
  focus-beacon     Atomically focus a fresh item and request a beacon (debug validation).
  focus-vqa        Atomically focus a fresh item and request VQA (debug validation).
  stop             Stop Android Node and release its listener/model resources.
EOF
}

serial=""
command_name=""
while (($#)); do
    case "$1" in
        --serial) serial="${2:-}"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        start-automatic|start-indoor|start-outdoor|microphone|ambient-profile|speech-timeout-probe|speech-timeout-probe-status|avc-decode-fault|wifi-direct-recover|wifi-direct-recover-5ghz|wifi-direct-negotiate|wifi-direct-recovery-status|status|focus-status|focus-next|focus-previous|focus-activate|focus-back|focus-beacon|focus-vqa|stop)
            [[ -z "$command_name" ]] || { printf 'error: only one command is allowed\n' >&2; exit 2; }
            command_name="$1"
            shift
            ;;
        *) printf 'error: unsupported argument; use --help\n' >&2; exit 2 ;;
    esac
done

[[ -n "$serial" && -n "$command_name" ]] || { usage >&2; exit 2; }
[[ "$serial" != *$'\n'* ]] || { printf 'error: malformed serial\n' >&2; exit 2; }
[[ "$(adb -s "$serial" get-state 2>/dev/null || true)" == "device" ]] || {
    printf 'error: selected Android device is not authorized and online\n' >&2
    exit 1
}
adb -s "$serial" shell pm path "$PACKAGE_NAME" >/dev/null 2>&1 || {
    printf 'error: debuggable Android Node APK is not installed\n' >&2
    exit 1
}

case "$command_name" in
    start-automatic) action="org.conceptflow.mpl.host.debug.START_AUTOMATIC" ;;
    start-indoor) action="org.conceptflow.mpl.host.debug.START_INDOOR" ;;
    start-outdoor) action="org.conceptflow.mpl.host.debug.START_OUTDOOR" ;;
    microphone) action="" ;;
    ambient-profile) action="org.conceptflow.mpl.host.debug.REQUEST_AMBIENT_PROFILE" ;;
    speech-timeout-probe) action="org.conceptflow.mpl.host.debug.SPEECH_TIMEOUT_PROBE" ;;
    wifi-direct-recover) action="org.conceptflow.mpl.host.debug.RECOVER_WIFI_DIRECT" ;;
    wifi-direct-recover-5ghz) action="org.conceptflow.mpl.host.debug.RECOVER_WIFI_DIRECT_5GHZ" ;;
    wifi-direct-negotiate) action="org.conceptflow.mpl.host.debug.PREPARE_WIFI_DIRECT_NEGOTIATION" ;;
    stop) action="org.conceptflow.mpl.host.debug.STOP" ;;
    speech-timeout-probe-status|avc-decode-fault|wifi-direct-recovery-status|status|focus-status|focus-next|focus-previous|focus-activate|focus-back|focus-beacon|focus-vqa) action="" ;;
esac
if [[ -n "$action" ]]; then
    adb -s "$serial" shell am start --user 0 -W -n "$CONTROL_ACTIVITY" -a "$action" >/dev/null
    printf 'command=%s dispatched\n' "$command_name"
    exit 0
fi

case "$command_name" in
    microphone) control_path="microphone" ;;
    status) control_path="status" ;;
    speech-timeout-probe-status) control_path="speech-timeout-probe-status" ;;
    avc-decode-fault) control_path="avc-decode-fault" ;;
    wifi-direct-recovery-status) control_path="wifi-direct-recovery-status" ;;
    focus-status) control_path="focus-status" ;;
    focus-next) control_path="focus/next" ;;
    focus-previous) control_path="focus/previous" ;;
    focus-activate) control_path="focus/activate" ;;
    focus-back) control_path="focus/back" ;;
    focus-beacon) control_path="focus/beacon" ;;
    focus-vqa) control_path="focus/vqa" ;;
esac
result="$(timeout --foreground 10s adb -s "$serial" shell content query --user 0 \
    --uri "$CONTROL_URI/$control_path" 2>/dev/null || true)"
[[ "$result" == *"Row: 0 status="* ]] || {
    printf 'error: Android Node debug control did not return a result\n' >&2
    exit 1
}
printf '%s\n' "$result"
