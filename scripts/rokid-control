#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0

set -euo pipefail
# shellcheck source=lib/common.sh
source "$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"
# shellcheck source=lib/rokid-adb.sh
source "$SCRIPT_DIRECTORY/lib/rokid-adb.sh"
cd "$REPOSITORY_ROOT"

readonly PACKAGE_NAME="org.conceptflow.mpl.rokidclient"
readonly COMMAND_ACTIVITY_NAME="org.conceptflow.mpl.rokid.RokidCommandActivity"
readonly ACTION_PREFIX="org.conceptflow.mpl.rokid.action"

serial=""
command_name=""

usage() {
    cat <<'EOF'
Usage: ./scripts/rokid-control [--serial SERIAL] COMMAND

Control the directly sideloaded, screenless Rokid runtime over authorized ADB.
The live-link and idle-control commands require a debuggable APK. Run
android-live-link-pair first, then start the Poco listener before live-link-start.

Commands:
  capture-start  Explicitly start camera capture (CAMERA must already be granted).
  stream-test    Run an eight-second leased gate test; microphone stops after two seconds.
  live-link-init Create/reuse only the Rokid live identity and public-certificate export.
  live-link-start Run a bounded 30-second authenticated camera+IMU live-link test.
  live-link-soak  Run a debug-only bounded 10-minute camera+IMU soak test.
  live-link-stop Stop only the active live-link test and its sensor producers.
  idle-enable    Persist and start sensor-off private-network rendezvous standby.
  idle-disable   Disable persisted idle control and stop its foreground service.
  physical-trace Capture once and use the ADB-reverse loopback gRPC development path.
  codec-benchmark  Benchmark bounded synthetic 640x640 I420 input on hardware AVC/HEVC encoders.
  cue-left       Emit one development left audio/haptic cue.
  cue-right      Emit one development right audio/haptic cue.
  brand-audio-test  Play the complete brand narration without changing its 72-hour timestamp.
  legacy-spool-enable  Enable diagnostic disk/JSON handoff for the next session.
  legacy-spool-disable Disable diagnostic disk/JSON handoff for the next session (production default).
  stop           Stop all inputs/service state and disable persisted idle control.
  status         Report package, permission, process, and service state.

Options:
  --serial SERIAL  Explicit ADB serial. Required when multiple devices are attached.
  -h, --help       Show this help.
EOF
}

while (($# > 0)); do
    case "$1" in
        --serial)
            (($# >= 2)) || fail "--serial requires a value"
            serial="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        capture-start|stream-test|live-link-init|live-link-start|live-link-soak|live-link-stop|idle-enable|idle-disable|physical-trace|codec-benchmark|cue-left|cue-right|brand-audio-test|legacy-spool-enable|legacy-spool-disable|stop|status)
            [[ -z "$command_name" ]] || fail "only one command may be supplied"
            command_name="$1"
            shift
            ;;
        *)
            fail "unknown argument '$1'; use --help"
            ;;
    esac
done

[[ -n "$command_name" ]] || fail "a command is required; use --help"
select_rokid_target "$serial"
verify_rokid_target

component="$PACKAGE_NAME/$COMMAND_ACTIVITY_NAME"
case "$command_name" in
    capture-start)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.START_CAPTURE"
        printf 'Requested explicit nonvisual camera capture.\n'
        ;;
    stream-test)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.START_STREAM_TEST"
        printf 'Requested bounded leased stream test; microphone stops after two seconds.\n'
        ;;
    live-link-init)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.INITIALIZE_LIVE_IDENTITY"
        printf 'Requested app-private live-link identity initialization and public-certificate export.\n'
        ;;
    live-link-start)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.START_LIVE_LINK_TEST"
        printf 'Requested bounded authenticated camera+IMU live-link test; microphone remains disabled.\n'
        ;;
    live-link-soak)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.START_LIVE_LINK_SOAK_TEST"
        printf 'Requested debug-only bounded 10-minute live-link soak; microphone remains disabled.\n'
        ;;
    live-link-stop)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.STOP_LIVE_LINK_TEST"
        printf 'Requested live-link test stop.\n'
        ;;
    idle-enable)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.ENABLE_IDLE_CONTROL"
        printf 'Requested visible arming of sensor-off authenticated private-network standby.\n'
        printf 'A transparent input-pass-through Activity remains visible while armed so YodaOS keeps camera eligibility.\n'
        printf 'Capture remains authorized only by an authenticated Poco Start command.\n'
        ;;
    idle-disable)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.DISABLE_IDLE_CONTROL"
        printf 'Requested idle-control disable and foreground-service stop.\n'
        ;;
    physical-trace)
        require_command ss "iproute2 is required to verify the loopback backend"
        mapfile -t listener_addresses < <(ss -H -ltn 'sport = :50051' | awk '{print $4}')
        if ((${#listener_addresses[@]} == 0)); then
            fail "no local backend is listening on TCP 50051; start the development cluster first"
        fi
        for listener_address in "${listener_addresses[@]}"; do
            case "$listener_address" in
                "127.0.0.1:50051"|"[::1]:50051"|"[::ffff:127.0.0.1]:50051") ;;
                *) fail "TCP 50051 must listen only on loopback; found $listener_address" ;;
            esac
        done
        adb -s "$ROKID_SERIAL" reverse tcp:50051 tcp:50051 >/dev/null
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.START_PHYSICAL_TRACE"
        printf 'Requested one bounded physical trace over the authorized ADB reverse tunnel.\n'
        printf 'Raw microphone audio remains on the glasses; only aggregate activity is reported.\n'
        ;;
    codec-benchmark)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.BENCHMARK_VIDEO_CODECS"
        printf 'Requested bounded hardware AVC/HEVC encoder benchmark using synthetic I420 frames.\n'
        ;;
    cue-left)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.PLAY_LEFT_CUE"
        printf 'Requested one left development cue.\n'
        ;;
    cue-right)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.PLAY_RIGHT_CUE"
        printf 'Requested one right development cue.\n'
        ;;
    brand-audio-test)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.PLAY_FULL_BRAND_TEST"
        printf 'Requested debug-only full branded-audio sequence; production cadence is unchanged.\n'
        ;;
    legacy-spool-enable)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.ENABLE_LEGACY_SENSOR_SPOOL"
        printf 'Enabled diagnostic legacy spool for the next sensor session.\n'
        ;;
    legacy-spool-disable)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.DISABLE_LEGACY_SENSOR_SPOOL"
        printf 'Disabled legacy spool; the next sensor session uses in-memory transport.\n'
        ;;
    stop)
        adb -s "$ROKID_SERIAL" shell am start --user 0 -W \
            -n "$component" -a "$ACTION_PREFIX.STOP"
        printf 'Requested full runtime stop and persisted idle-control disable.\n'
        ;;
    status)
        if adb -s "$ROKID_SERIAL" shell pm path "$PACKAGE_NAME" >/dev/null 2>&1; then
            printf 'package: installed\n'
        else
            printf 'package: not installed\n'
            exit 0
        fi
        package_dump="$(adb -s "$ROKID_SERIAL" shell dumpsys package "$PACKAGE_NAME")"
        permission_state="$(printf '%s\n' "$package_dump" | \
            awk '/android.permission.CAMERA: granted=/{if ($0 ~ /granted=true/) print "granted"; else print "denied"; exit}')"
        printf 'camera permission: %s\n' "${permission_state:-unknown}"
        microphone_permission="$(printf '%s\n' "$package_dump" | \
            awk '/android.permission.RECORD_AUDIO: granted=/{if ($0 ~ /granted=true/) print "granted"; else print "denied"; exit}')"
        printf 'microphone permission: %s\n' "${microphone_permission:-unknown}"
        process_running=false
        if adb -s "$ROKID_SERIAL" shell pidof "$PACKAGE_NAME" >/dev/null 2>&1; then
            process_running=true
            printf 'process: running\n'
        else
            printf 'process: stopped\n'
        fi
        service_dump="$(adb -s "$ROKID_SERIAL" shell dumpsys activity services "$PACKAGE_NAME")"
        if [[ "$process_running" == true ]] && grep -F "RokidRuntimeService" <<<"$service_dump" >/dev/null; then
            printf 'runtime service: running\n'
        else
            printf 'runtime service: stopped\n'
        fi
        if grep -F "isForeground=true" <<<"$service_dump" >/dev/null; then
            printf 'idle foreground service: active\n'
        elif grep -F "startRequested=true" <<<"$service_dump" >/dev/null &&
            grep -F "foregroundNoti=Notification(channel=rokid_idle_control" \
                <<<"$service_dump" >/dev/null &&
            adb -s "$ROKID_SERIAL" shell dumpsys activity lru 2>/dev/null | \
                grep -E "vis[[:space:]]+BFGS.*${PACKAGE_NAME}" >/dev/null; then
            # This API-32 YodaOS build can expose an accepted foreground
            # runtime as BFGS with an attached service notification while the
            # ServiceRecord's generic isForeground field remains false.
            printf 'idle foreground service: active (YodaOS BFGS/notification evidence)\n'
        else
            printf 'idle foreground service: inactive or unavailable\n'
        fi
        accessibility_status="$(
            "$SCRIPT_DIRECTORY/rokid-accessibility-control" --serial "$ROKID_SERIAL" status 2>&1
        )" || fail "could not verify Rokid gesture observer state"
        printf '%s\n' "$accessibility_status" | sed '/^Rokid target:/d'
        idle_preferences="$(adb -s "$ROKID_SERIAL" shell run-as "$PACKAGE_NAME" \
            cat "shared_prefs/rokid_idle_control.xml" 2>/dev/null || true)"
        if grep -E 'name="enabled" value="true"' <<<"$idle_preferences" >/dev/null; then
            printf 'persisted idle control: enabled\n'
        elif [[ -n "$idle_preferences" ]]; then
            printf 'persisted idle control: disabled\n'
        else
            printf 'persisted idle control: unknown (run-as unavailable or no stored choice)\n'
        fi
        spool_preferences="$(adb -s "$ROKID_SERIAL" shell run-as "$PACKAGE_NAME" \
            cat "shared_prefs/legacy_sensor_spool.xml" 2>/dev/null || true)"
        if grep -E 'name="enabled" value="true"' <<<"$spool_preferences" >/dev/null; then
            printf 'sensor handoff: diagnostic legacy spool (next session)\n'
        else
            printf 'sensor handoff: in-memory streaming (production default)\n'
        fi
        ;;
esac
