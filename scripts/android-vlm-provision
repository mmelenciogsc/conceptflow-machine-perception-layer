#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
set -euo pipefail

readonly PACKAGE="org.conceptflow.mpl.androidhost"
readonly MODEL_NAME="Qwen3-VL-2B-Instruct-Q4_0.gguf"
readonly PROJECTOR_NAME="mmproj-F16.gguf"
readonly MODEL_BYTES="1056784064"
readonly PROJECTOR_BYTES="819395232"
readonly MODEL_SHA256="d9ca31f524d063c04e49d1af7b0b37061b21e7f8a7e460141654efe287600234"
readonly PROJECTOR_SHA256="cd5a851d3928697fa1bd76d459d2cc409b6cf40c9d9682b2f5c8e7c6a9f9630f"

usage() {
    printf '%s\n' \
        "Usage: $0 --serial SERIAL --model FILE --projector FILE" \
        "Provision the pinned Qwen3-VL-2B Q4_0 decoder and F16 vision projector." \
        "The script never downloads artifacts and never copies them into this repository."
}

serial=""
model=""
projector=""
while (($#)); do
    case "$1" in
        --serial) serial="${2:-}"; shift 2 ;;
        --model) model="${2:-}"; shift 2 ;;
        --projector) projector="${2:-}"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ -z "$serial" || -z "$model" || -z "$projector" ]]; then
    usage >&2
    exit 2
fi
command -v adb >/dev/null || { printf 'adb is required.\n' >&2; exit 1; }
command -v sha256sum >/dev/null || { printf 'sha256sum is required.\n' >&2; exit 1; }
[[ "$(adb -s "$serial" get-state 2>/dev/null || true)" == "device" ]] || {
    printf 'Selected Android device is not authorized and online.\n' >&2
    exit 1
}
soc="$(adb -s "$serial" shell getprop ro.soc.model | tr -d '\r')"
if [[ "$soc" != "SM8750" && "$soc" != "SM8850" ]]; then
    printf 'The pinned GenieX Android route requires an explicitly supported Snapdragon 8 Elite device.\n' >&2
    exit 1
fi
adb -s "$serial" shell pm path "$PACKAGE" >/dev/null 2>&1 || {
    printf 'Install the debuggable Android Node APK before provisioning the VLM.\n' >&2
    exit 1
}
adb -s "$serial" shell run-as "$PACKAGE" mkdir -p files/local-vlm || {
    printf 'run-as failed; this helper requires a debuggable app build.\n' >&2
    exit 1
}
adb -s "$serial" shell run-as "$PACKAGE" chmod 700 files/local-vlm

validate_local() {
    local path="$1"
    local expected_bytes="$2"
    local expected_digest="$3"
    [[ -f "$path" ]] || { printf 'Missing artifact: %s\n' "$path" >&2; exit 1; }
    [[ "$(stat -c '%s' -- "$path")" == "$expected_bytes" ]] || {
        printf 'Artifact size does not match the pinned release.\n' >&2
        exit 1
    }
    [[ "$(head -c 4 -- "$path")" == "GGUF" ]] || {
        printf 'Artifact does not have GGUF magic.\n' >&2
        exit 1
    }
    local digest
    digest="$(sha256sum -- "$path")"
    digest="${digest%% *}"
    [[ "$digest" == "$expected_digest" ]] || {
        printf 'Artifact digest does not match the pinned release.\n' >&2
        exit 1
    }
}

provision() {
    local source_path="$1"
    local target_name="$2"
    local expected_digest="$3"
    local temporary="files/local-vlm/$target_name.tmp"
    local destination="files/local-vlm/$target_name"
    adb -s "$serial" shell run-as "$PACKAGE" rm -f "$temporary"
    if ! adb -s "$serial" exec-in run-as "$PACKAGE" sh -c \
        "umask 077; cat > '$temporary'" < "$source_path"; then
        adb -s "$serial" shell run-as "$PACKAGE" rm -f "$temporary" || true
        printf 'Artifact transfer was interrupted; the previous installed artifact was preserved.\n' >&2
        exit 1
    fi
    local installed_digest
    installed_digest="$(adb -s "$serial" shell run-as "$PACKAGE" sha256sum "$temporary")"
    installed_digest="${installed_digest%% *}"
    installed_digest="${installed_digest//$'\r'/}"
    if [[ "$installed_digest" != "$expected_digest" ]]; then
        adb -s "$serial" shell run-as "$PACKAGE" rm -f "$temporary" || true
        printf 'Post-transfer checksum mismatch.\n' >&2
        exit 1
    fi
    adb -s "$serial" shell run-as "$PACKAGE" mv "$temporary" "$destination"
    adb -s "$serial" shell run-as "$PACKAGE" chmod 600 "$destination"
}

validate_local "$model" "$MODEL_BYTES" "$MODEL_SHA256"
validate_local "$projector" "$PROJECTOR_BYTES" "$PROJECTOR_SHA256"
provision "$model" "$MODEL_NAME" "$MODEL_SHA256"
provision "$projector" "$PROJECTOR_NAME" "$PROJECTOR_SHA256"
printf 'Pinned Qwen3-VL-2B Q4_0 artifacts passed local and on-device verification.\n'
